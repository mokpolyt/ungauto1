{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/*.ts": {
      "maxDuration": 300
    },
    "api/topics.ts": {
      "maxDuration": 30
    },
    "api/status.ts": {
      "maxDuration": 30
    },
    "api/posts.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "0 1 */3 * *"
    },
    {
      "path": "/api/cron/resume",
      "schedule": "0 13 * * *"
    }
  ]
}